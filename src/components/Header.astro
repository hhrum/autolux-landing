---
import { getCollection } from 'astro:content';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
import { getSingleton } from '../lib/content';

const brand = (await getSingleton('brand')).data;

const navLinks = (await getCollection('navigation')).sort(
  (a, b) => a.data.order - b.data.order,
);

const homeHref = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<header class="header">
  <div class="container header__inner">
    <a class="brand" href={homeHref} aria-label="AutoLux — на главную">
      <img class="brand__logo" src={brand.logo.src} width="40" height="40" alt="" />
      <span class="brand__text">
        <span class="brand__name">{brand.name}</span>
        <span class="brand__tagline">{brand.tagline}</span>
      </span>
    </a>

    <nav class="nav" aria-label="Основная навигация">
      {
        navLinks.map((link) => (
          <a class="nav__link" href={link.data.href}>
            {link.data.label}
          </a>
        ))
      }
    </nav>

    <div class="header__actions">
      <a class="phone" href={brand.phoneHref}>
        <Icon name="phone" size={16} />
        <span>{brand.phone}</span>
      </a>
      <Button class="header__cta" href="#contacts">Запись онлайн</Button>
    </div>

    <button
      class="menu-btn"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span class="visually-hidden">Открыть меню</span>
      <Icon name="menu" size={18} class="menu-btn__open" />
      <Icon name="close" size={18} class="menu-btn__close" />
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden data-mobile-menu>
    <nav class="mobile-menu__nav" aria-label="Мобильная навигация">
      {
        navLinks.map((link) => (
          <a class="mobile-menu__link" href={link.data.href}>
            {link.data.label}
          </a>
        ))
      }
    </nav>
    <a class="phone phone--mobile" href={brand.phoneHref}>
      <Icon name="phone" size={16} />
      <span>{brand.phone}</span>
    </a>
    <Button href="#contacts" block>Запись онлайн</Button>
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-menu-toggle]');
  const menu = document.querySelector('[data-mobile-menu]');
  if (toggle instanceof HTMLButtonElement && menu instanceof HTMLElement) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.classList.toggle('is-open', open);
      menu.classList.toggle('is-open', open);
      menu.hidden = !open;
      document.body.classList.toggle('menu-open', open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--border);
    background: rgba(10, 10, 12, 0.92);
    backdrop-filter: blur(10px);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 70px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .brand__logo {
    width: 36px;
    height: 36px;
    border-radius: 18px;
    object-fit: cover;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 900;
    letter-spacing: 0.5px;
    line-height: 1.1;
  }

  .brand__tagline {
    font-size: 10px;
    font-weight: 500;
    color: var(--accent);
    letter-spacing: 0.02em;
  }

  .nav {
    display: none;
    align-items: center;
    gap: 24px;
  }

  .nav__link {
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .nav__link:hover {
    color: var(--text);
  }

  .header__actions {
    display: none;
    align-items: center;
    gap: 20px;
  }

  .phone {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
  }

  .phone--mobile {
    justify-content: center;
  }

  .menu-btn {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--accent);
    background: var(--surface);
  }

  .menu-btn :global(.menu-btn__close) {
    display: none;
  }

  .menu-btn.is-open :global(.menu-btn__open) {
    display: none;
  }

  .menu-btn.is-open :global(.menu-btn__close) {
    display: block;
  }

  .mobile-menu {
    display: none;
    flex-direction: column;
    gap: 20px;
    min-height: calc(100dvh - 70px);
    padding: 16px var(--container-pad) 24px;
    overflow-y: auto;
    border-top: 1px solid var(--border);
    background: var(--bg);
  }

  .mobile-menu.is-open {
    display: flex;
  }

  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .mobile-menu__link {
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    font-size: 16px;
    font-weight: 600;
  }

  :global(body.menu-open) {
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .header__inner {
      min-height: 86px;
    }

    .brand__logo {
      width: 36px;
      height: 36px;
    }

    .brand__name {
      font-size: 20px;
    }

    .brand__tagline {
      font-size: 11px;
    }

    .header__actions {
      display: flex;
    }

    .menu-btn,
    .mobile-menu,
    .mobile-menu.is-open {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    .header__inner {
      min-height: 84px;
    }

    .brand__logo {
      width: 40px;
      height: 40px;
      border-radius: 20px;
    }

    .brand__name {
      font-size: 22px;
    }

    .nav {
      display: flex;
    }

    .header__cta {
      display: none;
    }
  }

  @media (min-width: 1440px) {
    .header__inner {
      min-height: 92px;
    }

    .nav {
      gap: 28px;
    }

    .header__cta {
      display: inline-flex;
    }
  }
</style>
