---
import { render } from 'astro:content';
import SectionHeader from './ui/SectionHeader.astro';
import { getSection, getSingleton } from '../lib/content';

const section = await getSection('comfort');
const comfortEntry = await getSingleton('comfort');
const { Content } = await render(comfortEntry);
---

<section class="section comfort">
  <div class="container comfort__inner">
    <SectionHeader badge={section.data.badge} title={section.data.title} />

    <div class="comfort__content">
      <div class="comfort__media">
        <img
          src={comfortEntry.data.image.src}
          alt="Зона ожидания AutoLux"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="comfort__details">
        <div class="comfort__text">
          <Content />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .comfort__inner {
    display: flex;
    flex-direction: column;
    gap: var(--section-gap);
  }

  .comfort__content {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .comfort__media {
    overflow: hidden;
    border-radius: var(--radius-lg);
  }

  .comfort__media img {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }

  .comfort__details {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .comfort__text {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .comfort__text :global(p) {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.5;
  }

  .comfort__text :global(ul) {
    display: flex;
    flex-direction: column;
    gap: 12px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .comfort__text :global(li) {
    position: relative;
    padding-left: 20px;
    font-size: 14px;
  }

  .comfort__text :global(li::before) {
    content: '';
    position: absolute;
    top: 5px;
    left: 0;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: var(--accent);
  }

  @media (min-width: 768px) {
    .comfort__media img {
      height: 200px;
    }

    .comfort__text :global(p) {
      font-size: 16px;
    }
  }

  @media (min-width: 1024px) {
    .comfort__content {
      flex-direction: row;
      align-items: center;
      gap: 40px;
    }

    .comfort__media,
    .comfort__details {
      flex: 1;
      min-width: 0;
    }

    .comfort__media img {
      height: 340px;
    }
  }
</style>
