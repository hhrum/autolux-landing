---
import { brand, footer } from '../data/content';
---

<footer class="footer">
  <div class="container footer__inner">
    <a class="footer__brand" href="/" aria-label="AutoLux">
      <img src={brand.logo.src} width="32" height="32" alt="" />
      <span>{brand.name}</span>
    </a>
    <p class="footer__copy">{footer.copyright}</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    background: var(--bg-alt);
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-block: 32px;
  }

  .footer__brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 800;
  }

  .footer__brand img {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    object-fit: cover;
  }

  .footer__copy {
    color: var(--muted);
    font-size: 13px;
  }

  @media (min-width: 768px) {
    .footer__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding-block: 40px;
    }

    .footer__brand img {
      width: 28px;
      height: 28px;
    }

    .footer__copy {
      font-size: 14px;
    }
  }

  @media (min-width: 1024px) {
    .footer__brand img {
      width: 32px;
      height: 32px;
    }

    .footer__brand {
      font-size: 20px;
    }
  }
</style>
