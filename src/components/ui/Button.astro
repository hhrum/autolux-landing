---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  block?: boolean;
  class?: string;
}

const { href, variant = 'primary', block = false, class: className = '' } = Astro.props;
---

<a
  class:list={['btn', `btn--${variant}`, block && 'btn--block', className]}
  href={href}
>
  <slot />
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 24px;
    border-radius: var(--radius);
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .btn--primary {
    background: var(--accent);
    color: var(--bg);
    box-shadow: var(--accent-shadow);
  }

  .btn--primary:hover {
    filter: brightness(1.05);
    transform: translateY(-1px);
  }

  .btn--secondary {
    background: var(--bg-alt);
    border: 1px solid var(--border);
    color: var(--text);
    font-weight: 600;
  }

  .btn--secondary:hover {
    border-color: var(--muted);
  }

  .btn--block {
    width: 100%;
  }

  @media (min-width: 1024px) {
    .btn {
      padding: 16px 28px;
    }
  }
</style>
