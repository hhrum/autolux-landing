---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<span class="badge">{text}</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    padding: 6px 12px;
    border: 1px solid var(--accent);
    border-radius: 100px;
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    white-space: nowrap;
  }
</style>
