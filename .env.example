# GitHub API for /admin publishing (POC only — token is exposed in client bundle)
# Astro client: requires vite.envPrefix including VITE_ (see astro.config.mjs)
VITE_GH_TOKEN=
VITE_GH_OWNER=hhrum
VITE_GH_REPO=autolux-landing
VITE_GH_MAIN_BRANCH=main
VITE_GH_DRAFT_BRANCH=draft
VITE_GH_WORKFLOW_FILE=deploy.yml
