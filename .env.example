# GitHub API for /admin publishing (POC only — token is exposed in client bundle)
# Astro exposes only PUBLIC_* to the browser by default.
PUBLIC_GH_TOKEN=
PUBLIC_GH_OWNER=hhrum
PUBLIC_GH_REPO=autolux-landing
PUBLIC_GH_MAIN_BRANCH=main
PUBLIC_GH_DRAFT_BRANCH=draft
PUBLIC_GH_WORKFLOW_FILE=deploy.yml
